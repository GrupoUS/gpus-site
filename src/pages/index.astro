---
import { getCollection, getEntry } from "astro:content";
import { NarrativeChapters } from "../components/cinematic/NarrativeChapters.tsx";
import ProgramsCompare from "../components/cinematic/ProgramsCompare.astro";
import AboutPreview from "../components/home/AboutPreview.astro";
import CTASection from "../components/home/CTASection.astro";
import Hero from "../components/home/Hero.astro";
import { JourneyTimeline } from "../components/home/JourneyTimeline.tsx";
import StatsSection from "../components/home/StatsSection.astro";
import { TestimonialCarousel } from "../components/landing/TestimonialCarousel.tsx";
import Layout from "../layouts/Layout.astro";

const products = await getCollection("products");
const narrative = await getEntry("site", "home-narrative");

if (!narrative) {
	throw new Error(
		"Home narrative missing: expected src/content/site/home-narrative.json",
	);
}

/* ── Journey Timeline data ── */
const canonicalJourney = [
	{
		slug: "curso-auriculo",
		stage: "01",
		eyebrow: "Entrada",
		summary:
			"Entrada acessível para ganhar repertório técnico e colocar a primeira oferta em movimento.",
	},
	{
		slug: "comunidade-us",
		stage: "02",
		eyebrow: "Comunidade",
		summary:
			"Continuidade, networking e atualização recorrente para manter execução, proximidade e referência de mercado.",
	},
	{
		slug: "trintae3",
		stage: "03",
		eyebrow: "Formação sólida",
		summary:
			"Aprofundamento técnico e base de negócios para sair do operacional e construir autoridade.",
	},
	{
		slug: "mentoria-black-neon",
		stage: "04",
		eyebrow: "Escala de negócio",
		summary:
			"Gestão, time, faturamento e previsibilidade para transformar uma boa operação em empresa escalável.",
	},
	{
		slug: "otb",
		stage: "05",
		eyebrow: "Elite global",
		summary:
			"Etapa internacional para reconhecimento, networking premium e repertório de business em outro nível.",
	},
] as const;

const complementaryExperienceSlugs = ["neon-dash", "na-mesa-certa"] as const;
const productsBySlug = new Map(
	products.map((entry) => [entry.data.slug, entry.data]),
);

const stages = canonicalJourney.map((item) => {
	const product = productsBySlug.get(item.slug);
	if (!product)
		throw new Error(
			`JourneyTimeline: produto ausente para slug "${item.slug}"`,
		);
	return {
		slug: item.slug,
		stage: item.stage,
		eyebrow: item.eyebrow,
		summary: item.summary,
		productName: product.name,
		tagline: product.tagline,
		pageHref: product.externalSiteUrl ?? `/${product.slug}`,
		iconName: product.icon,
	};
});

const complementaryExperiences = complementaryExperienceSlugs
	.map((slug) => productsBySlug.get(slug))
	.filter((p): p is NonNullable<typeof p> => p !== undefined)
	.map((product) => ({
		name: product.name,
		href: product.externalSiteUrl ?? `/${product.slug}`,
	}));

/* ── Testimonials data ── */
const homeTestimonials = products
	.flatMap((p) =>
		p.data.testimonials.map((t) => ({
			name: t.name,
			role: `${t.role} (${p.data.name})`,
			quote: t.quote,
		})),
	)
	.slice(0, 9);

/* ── JSON-LD ItemList for AI citation + rich results ── */
const sortedProducts = [...products].sort(
	(a, b) => a.data.order - b.data.order,
);
const programsItemList = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: "Programas do Grupo US",
	itemListElement: sortedProducts.map((p, i) => ({
		"@type": "ListItem",
		position: i + 1,
		url: p.data.externalSiteUrl ?? `https://grupous.com.br/${p.data.slug}`,
		name: p.data.name,
		description: p.data.tagline,
	})),
};
---

<Layout
	title="Grupo US — Formação e negócios em saúde estética avançada"
	description="Quatro capítulos sobre como donos de clínica em saúde estética constroem autoridade, agenda cheia e faturamento previsível com método validado. Conheça os sete programas do ecossistema da Dra. Sacha Gualberto."
	ogImage="/og/home.png"
	activeNav="home"
	jsonLd={programsItemList}
>
	<Hero />
	<NarrativeChapters client:visible chapters={narrative.data.chapters} />
	<ProgramsCompare />
	<JourneyTimeline client:visible stages={stages} complementary={complementaryExperiences} />
	<TestimonialCarousel client:visible testimonials={homeTestimonials} />
	<StatsSection />
	<AboutPreview />
	<CTASection />
</Layout>
