---
import SectionHeading from "../shared/SectionHeading.astro";

interface Props {
	testimonials: Array<{
		name: string;
		role: string;
		quote: string;
	}>;
	/** `strip`: carrossel horizontal com scroll-snap no mobile; grid a partir de md */
	layout?: "grid" | "strip";
}

const { testimonials, layout = "grid" } = Astro.props;
const isStrip = layout === "strip";
---

<section class="px-4 py-20 sm:px-6 lg:px-8">
	<div class="mx-auto max-w-7xl">
		<SectionHeading title="O que dizem nossos alunos" />

		<div
			class:list={[
				"mt-14 gap-6",
				isStrip
					? "flex snap-x snap-mandatory overflow-x-auto pb-4 -mx-4 px-4 md:mx-0 md:grid md:snap-none md:overflow-visible md:pb-0 md:grid-cols-2 lg:grid-cols-3"
					: "grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3",
			]}
			class:home-testimonials-strip={isStrip}
		>
			{testimonials.map((testimonial, index) => (
				<blockquote
					class:list={[
						"glass-card rounded-2xl p-6 transition-all duration-300 md:p-8 hover:border-gold/30 hover:shadow-lg hover:shadow-gold/5",
						isStrip &&
							"w-[min(100vw-2rem,22rem)] shrink-0 snap-center sm:w-[24rem] md:w-auto md:shrink",
					]}
					data-reveal="up"
					data-reveal-delay={String(index + 1)}
				>
					<!-- Quote icon -->
					<svg
						class="mb-4 h-8 w-8 text-gold/30"
						viewBox="0 0 24 24"
						fill="currentColor"
						aria-hidden="true"
					>
						<path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151C7.563 6.068 6 8.789 6 11h4v10H0z" />
					</svg>

					<p class="italic leading-relaxed text-text-primary">
						"{testimonial.quote}"
					</p>

					<footer class="mt-5 border-t border-gold/10 pt-4">
						<cite class="not-italic flex items-center gap-3">
							<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-gold/30 to-gold/10 text-sm font-bold text-gold" aria-hidden="true">
								{testimonial.name.split(' ').map(n => n[0]).slice(0, 2).join('')}
							</div>
							<div>
								<span class="block font-semibold text-text-primary">
									{testimonial.name}
								</span>
								<span class="mt-0.5 block text-sm text-text-muted">
									{testimonial.role}
								</span>
							</div>
						</cite>
					</footer>
				</blockquote>
			))}
		</div>
	</div>
</section>

{isStrip && (
	<style>
		@media (prefers-reduced-motion: reduce) {
			.home-testimonials-strip {
				scroll-snap-type: none;
			}
		}
	</style>
)}
