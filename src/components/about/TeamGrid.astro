---
import { getCollection } from "astro:content";
import Card from "../shared/Card.astro";
import SectionHeading from "../shared/SectionHeading.astro";

const teamEntries = await getCollection("team");
const team = teamEntries
	.map((entry) => entry.data)
	.sort((a, b) => a.order - b.order);

function getInitials(name: string): string {
	return name
		.split(" ")
		.filter((word) => word.length > 2 || word === word.toUpperCase())
		.slice(0, 2)
		.map((word) => word[0].toUpperCase())
		.join("");
}
---

<section class="py-20 px-4" aria-labelledby="equipe-heading">
	<div class="max-w-6xl mx-auto">
		<SectionHeading
			title="Nossa Equipe"
			subtitle="Lideranca que inspira transformacao"
		/>

		<div class="mt-14 grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8">
			{team.map((member, index) => (
				<div data-reveal="scale" data-reveal-delay={String(index + 1)}>
					<Card hoverable class="h-full text-center">
						<div class="flex justify-center mb-5">
							<div class="w-32 h-32 rounded-full bg-navy-lighter flex items-center justify-center border-2 border-gold/20">
								<span class="font-serif text-3xl font-bold text-gold/60" aria-hidden="true">
									{getInitials(member.name)}
								</span>
							</div>
						</div>

						<h3 class="font-serif text-xl font-semibold text-gold">
							{member.name}
						</h3>
						<p class="text-text-muted text-sm uppercase tracking-wider mt-1">
							{member.role}
						</p>
						<p class="text-text-muted text-sm mt-3 leading-relaxed">
							{member.bio}
						</p>

						{member.social.instagram && (
							<a
								href={member.social.instagram}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-2 mt-4 text-gold/70 hover:text-gold transition-colors duration-200"
								aria-label={`Instagram de ${member.name}`}
							>
								<svg
									class="w-5 h-5"
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
									<line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
								</svg>
								<span class="text-sm">Instagram</span>
							</a>
						)}
					</Card>
				</div>
			))}
		</div>
	</div>
</section>
