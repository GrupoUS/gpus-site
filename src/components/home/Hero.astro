---
import Button from "../shared/Button.astro";
import { AuroraBackground } from "../ui/aurora-background";
import { Spotlight } from "../ui/spotlight";
import { TextGenerateEffect } from "../ui/text-generate-effect";
---

<section class="relative overflow-hidden">
	<AuroraBackground client:load className="min-h-screen bg-navy">
		<Spotlight fill="#d4af37" className="-top-40 left-0 md:left-60 md:-top-20" />

		<div class="relative z-10 mx-auto max-w-4xl px-4 text-center sm:px-6">
			<!-- Gold badge -->
			<div data-reveal="up">
				<span class="inline-block rounded-sm border border-gold/30 bg-navy-light/80 px-4 py-1.5 text-xs font-semibold uppercase tracking-[0.2em] text-gold">
					Formação · Gestão · Comunidade
				</span>
			</div>

			<!-- Headline with text generate effect -->
			<div class="mt-8" data-reveal="up" data-reveal-delay="1">
				<TextGenerateEffect
					client:load
					words="Transformamos profissionais da saúde em referências na estética avançada"
					className="font-serif text-4xl md:text-5xl lg:text-6xl font-bold text-text-primary"
				/>
			</div>

			<!-- Subtitle -->
			<p
				class="mx-auto mt-6 max-w-3xl text-lg leading-relaxed text-text-muted md:text-xl"
				data-reveal="up"
				data-reveal-delay="2"
			>
				Programas com quem lidera o mercado: técnica, gestão e networking para você
				crescer em autoridade, faturamento e reputação — com trilha clara do primeiro
				curso à mentoria de escala.
			</p>

			<!-- CTA Buttons -->
			<div
				class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
				data-reveal="up"
				data-reveal-delay="3"
			>
				<Button variant="primary" href="#produtos" size="lg">
					Ver trilha de programas
				</Button>
				<Button variant="outline" href="/contato" size="lg">
					Fale conosco
				</Button>
			</div>
		</div>
	</AuroraBackground>
</section>
