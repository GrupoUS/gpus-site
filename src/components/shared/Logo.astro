---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["inline-flex items-center gap-3", className]}>
	<span
		class="flex h-10 w-10 items-center justify-center rounded-xl border border-gold/35 bg-navy-light text-sm font-bold tracking-[0.2em] text-gold sm:h-11 sm:w-11"
		aria-hidden="true"
	>
		GU
	</span>
	<span class="font-serif text-2xl font-bold tracking-tight text-gold sm:text-3xl">
		Grupo <span class="text-text-primary">US</span>
	</span>
</span>
